# Copiar a .env dentro del backend. Las claves se leen solo aquí.
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SIMULATION_DATA_DIR=./data/sessions
# IA opcional. Sin clave, el motor determinista sigue disponible.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

# Supabase (servidor). La publishable key puede ir aquí; la DB password solo en .env local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Contraseña de la base (Direct connection). No la uses en el frontend.
# SUPABASE_DB_PASSWORD=

# NASA key: server only. DEMO_KEY is allowed only outside production.
NASA_API_KEY=DEMO_KEY
