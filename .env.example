# Copiá este archivo a .env en esta carpeta.
# No pongas claves reales en el repositorio ni en los logs.
# Si AI_API_KEY está vacío, el servicio responde "no configurado" y el simulador usa el motor local.
# Si esta clave falta aquí, el servidor también lee AI_* de ../astrodeepspacenasa/.env. No copia el PORT de esa carpeta.

# openai-compatible | anthropic
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

# Puerto que usa el proxy de VITALINK.
PORT=3000
