# Copiar a .env dentro del backend. Las claves se leen solo aquí.
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SIMULATION_DATA_DIR=./data/sessions
# IA opcional. Sin clave, el motor determinista sigue disponible.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000
