# Copiar a .env dentro del backend. Las claves se leen solo aquí.
PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SIMULATION_DATA_DIR=./data/sessions
# IA opcional. Sin clave, el motor determinista sigue disponible.
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=25000

# Supabase (servidor). La publishable key puede ir aquí; la DB password solo en .env local.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo en el servidor. Con esta clave, Nest guarda el registro principal en helios_platform_state
# (ver supabase/helios_platform_state.sql). Sin ella, la plataforma sigue en platform-db.json.
# SUPABASE_SERVICE_ROLE_KEY=
# Contraseña de la base (Direct connection). No la uses en el frontend.
# SUPABASE_DB_PASSWORD=

# NASA key: server only. DEMO_KEY is allowed only outside production.
NASA_API_KEY=DEMO_KEY

# Local request limits per observed client IP and per process, in 60-second windows.
# Keep Express proxy trust disabled unless a trusted ingress has been configured explicitly.
AI_RATE_LIMIT_PER_MINUTE=20
WRITE_RATE_LIMIT_PER_MINUTE=240
SESSION_RATE_LIMIT_PER_MINUTE=20
# AI also has a process budget: 60 calls/minute, max 2 simultaneous calls, 1200 output tokens.
# JSON limits: AI 64 KiB; regular API 256 KiB; simulation initialization/import 10 MiB.

# Gemini via the existing compatible adapter (backend only):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
# AI_API_KEY=YOUR_GEMINI_API_KEY
# AI_REASONING_EFFORT=low
# First verify the selected model using the account's model list.

# Opt in only when your managed network CA is trusted by the OS. TLS validation stays enabled.
# Requires Node with getCACertificates/setDefaultCACertificates support.
AI_USE_SYSTEM_CA=false
